<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:hui="using:Haven.Desktop.HavenUI.Components"
             xmlns:controls="using:Haven.Desktop.Controls"
             xmlns:topRail="using:Haven.Desktop.Views.Shell.TopRail"
             xmlns:sidebar="using:Haven.Desktop.Views.Shell.Sidebar"
             x:Class="Haven.Desktop.Views.Shell.MainView"
             x:Name="MainViewRoot">

  <!-- Revision preview: use the full-height left sidebar as the primary shell
       navigation instead of the bottom rail. The bottom rail stays instantiated
       but hidden so its existing event/state wiring remains available while this
       layout is reviewed on the feature branch. -->
  <Grid RowDefinitions="*,Auto" Background="Transparent" ClipToBounds="True">
    <topRail:TopRail x:Name="TopRail"
                     Grid.Row="1"
                     IsVisible="False" />

    <Grid Grid.Row="0"
          ColumnDefinitions="Auto,*"
          ColumnSpacing="18"
          Margin="24,20,24,20"
          ClipToBounds="True">

      <!-- Primary navigation is now a real left sidebar rather than the bottom bar. -->
      <sidebar:Sidebar x:Name="SidebarControl"
                       Grid.Column="0"
                       Width="314"
                       IsVisible="True" />

      <ContentControl x:Name="NativeSidebarHost"
                      Grid.Column="0"
                      Width="330"
                      IsVisible="False" />

      <hui:HavenAdaptiveSurface x:Name="ContentArea"
              Grid.Column="1"
              Background="Transparent"
              BorderThickness="0"
              CornerRadius="0"
              ClipToBounds="True">
        <Grid>
          <Grid x:Name="PaneHost" ColumnDefinitions="*,0,0">
            <ContentControl x:Name="PageContent" Grid.Column="0" Margin="0" />
            <GridSplitter x:Name="SplitDivider"
                          Grid.Column="1"
                          Width="8"
                          Background="{DynamicResource HavenLineStrongBrush}"
                          ResizeDirection="Columns"
                          IsVisible="False"
                          Focusable="True"
                          AutomationProperties.Name="Resize split view" />
            <ContentControl x:Name="SecondaryPageContent"
                            Grid.Column="2"
                            Margin="0"
                            IsVisible="False" />
          </Grid>

          <!-- Retained as a hidden compatibility host for the existing event
               wiring. -->
          <Grid x:Name="ShellContextBar"
                IsVisible="False"
                IsHitTestVisible="False">
            <StackPanel x:Name="GoModeSwitcher" IsVisible="False">
              <hui:HavenButton x:Name="GoChatButton" IsVisible="False" />
              <hui:HavenButton x:Name="GoDashboardButton" IsVisible="False" />
              <TextBlock x:Name="GoModeLabel" Text="Go" />
            </StackPanel>
            <hui:HavenButton x:Name="StoredChatDropdown" IsVisible="False">
              <TextBlock x:Name="StoredChatLabel" Text="Saved Chat" />
              <hui:HavenButton.Flyout>
                <hui:HavenAdaptivePopup>
                  <StackPanel>
                    <hui:HavenButton x:Name="SavedChatOption" Content="Saved Chat" />
                    <hui:HavenButton x:Name="TemporaryChatOption" Content="Temporary Chat" />
                  </StackPanel>
                </hui:HavenAdaptivePopup>
              </hui:HavenButton.Flyout>
            </hui:HavenButton>
          </Grid>
        </Grid>
      </hui:HavenAdaptiveSurface>

      <Grid x:Name="NativeOverlayLayer"
            Grid.Column="1"
            Panel.ZIndex="20"
            ClipToBounds="True" />

      <hui:HavenAdaptiveSurface x:Name="OverlayHost"
              Grid.Column="1"
              Background="{DynamicResource HavenOverlaySurfaceBrush}"
              CornerRadius="22"
              ClipToBounds="True"
              IsVisible="False" />
    </Grid>
  </Grid>
</UserControl>